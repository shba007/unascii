{
  "name": "@shba007/unascii",
  "version": "0.4.1",
  "description": "Print any image in ascii anywhere (browser/cli)",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shba007/unascii.git"
  },
  "keywords": [],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "unascii": "./bin/unascii.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "volta": {
    "node": "22.14.0"
  },
  "engines": {
    "node": "^20.15.0 || ^22.11.0",
    "pnpm": "^9.15.0 || ^10.2.0"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "vitest dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "play": "dotenvx run -- jiti playground/cli",
    "build": "unbuild",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && pnpm publish && git push --follow-tags",
    "clean": "rm -rf coverage dist",
    "unascii": "node bin/unascii.mjs"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "chalk": "^5.4.1",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "pathe": "^2.0.3",
    "std-env": "^3.9.0",
    "unstorage": "^1.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@dotenvx/dotenvx": "^1.39.1",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.1",
    "changelogen": "^0.6.1",
    "eslint": "^9.24.0",
    "eslint-config-unjs": "^0.4.2",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "unbuild": "3.5.0",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}