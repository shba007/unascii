{
  "name": "unascii",
  "version": "0.3.0",
  "description": "Print any image in ascii anywhere (browser/cli)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/unascii.git"
  },
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "keywords": [],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "unascii": "./bin/unascii.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "volta": {
    "node": "22.12.0"
  },
  "engines": {
    "node": "^22.12.0",
    "pnpm": "^9.12.0"
  },
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "vitest dev",
    "lint": "eslint . --fix",
    "format": "prettier .  --write",
    "build": "unbuild",
    "prepack": "pnpm build",
    "play": "jiti playground/cli",
    "release": "pnpm test && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck",
    "unascii": "jiti playground/cli"
  },
  "dependencies": {
    "canvas": "^2.11.2",
    "chalk": "^5.3.0",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "pathe": "^1.1.2",
    "unstorage": "^1.13.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "changelogen": "^0.5.7",
    "eslint": "^9.16.0",
    "eslint-config-unjs": "^0.4.2",
    "jiti": "^2.4.1",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "unbuild": "3.0.0-rc.11",
    "unenv": "^1.10.0",
    "vitest": "^2.1.8"
  }
}
