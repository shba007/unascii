{
  "name": "@shba007/unascii",
  "version": "0.4.2",
  "description": "Print any image in ascii anywhere (browser/cli)",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shba007/unascii.git"
  },
  "keywords": [],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "unascii": "./bin/unascii.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": "^20.15.0 || ^22.11.0",
    "pnpm": "^9.15.0 || ^10.2.0",
    "bun": "^1.2.9"
  },
  "packageManager": "bun@1.2.16",
  "scripts": {
    "prepare": "husky || true",
    "dev": "vitest dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test": "bun lint && bun test:types && vitest run --coverage",
    "play": "dotenvx run -- jiti examples",
    "build": "unbuild",
    "prepack": "bun run build",
    "clean": "rm -rf coverage dist",
    "unascii": "bun bin/unascii.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "canvas": "^3.1.0",
    "chalk": "^5.4.1",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "pathe": "^2.0.3",
    "std-env": "^3.9.0",
    "tailwindcss": "^4.1.10",
    "unstorage": "^1.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@dotenvx/dotenvx": "^1.44.2",
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "changelogen": "^0.6.1",
    "eslint": "^9.29.0",
    "eslint-config-unjs": "^0.4.2",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "unbuild": "3.5.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}