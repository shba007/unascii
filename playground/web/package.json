{
  "name": "unascii-web",
  "version": "0.3.4",
  "description": "Print any image in ascii anywhere (browser/cli)",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/unascii.git"
  },
  "type": "module",
  "private": true,
  "volta": {
    "node": "22.13.1"
  },
  "engines": {
    "node": "^20.15.0 || ^22.11.0",
    "pnpm": "^9.15.0 || ^10.2.0"
  },
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "vite build",
    "preview": "vite preview",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t unascii-web:dev .",
    "docker:start": "docker run --detach --name unascii-web-dev -p 3100:8080 unascii-web:dev",
    "tunnel": "untun tunnel --port 3200 http://localhost:3200"
  },
  "dependencies": {
    "@shba007/unascii": "^0.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.19.8",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}